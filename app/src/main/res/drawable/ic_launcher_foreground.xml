<?xml version="1.0" encoding="utf-8"?>

<!-- App icon "Wave": Coral-orange gradient with emerald satellite and rounded play triangle. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group android:pivotX="54" android:pivotY="54">

        <!-- Coral-to-orange gradient circle -->
        <path
            android:pathData="M 54,19 A 35,35 0 1,0 54,89 A 35,35 0 1,0 54,19 Z">

            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="20"
                    android:startY="20"
                    android:endX="88"
                    android:endY="88">

                    <item
                        android:offset="0"
                        android:color="#FFFF8A3D" />

                    <item
                        android:offset="0.35"
                        android:color="#FFFF3C46" />

                    <item
                        android:offset="0.65"
                        android:color="#FFFF2855" />

                    <item
                        android:offset="1"
                        android:color="#FFFF8A24" />

                </gradient>
            </aapt:attr>
        </path>

        <!-- Emerald-green satellite -->
        <path
            android:fillColor="#FF00E676"
            android:pathData="M 70.6,31.8 A 5.4,5.4 0 1,0 70.6,42.6 A 5.4,5.4 0 1,0 70.6,31.8 Z" />

        <!-- White play triangle with subtly rounded corners -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="
                M 47.2,44.1
                C 47.2,41.8 49.7,40.5 51.8,41.6
                L 69.2,51.0
                C 71.4,52.2 71.4,55.8 69.2,57.0
                L 51.8,66.4
                C 49.7,67.5 47.2,66.2 47.2,63.9
                Z" />

    </group>
</vector>
