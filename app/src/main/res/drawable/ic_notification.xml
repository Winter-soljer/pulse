<?xml version="1.0" encoding="utf-8"?>
<!-- Pulse: outline vector of the icon (circle + satellite dot + centered play triangle) on 24x24 grid. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Main circle outline -->
    <path
        android:pathData="M 12,4.5 A 7.5,7.5 0 1,0 12,19.5 A 7.5,7.5 0 1,0 12,4.5 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- Satellite circle outline -->
    <path
        android:pathData="M 16,6.2 A 1.3,1.3 0 1,0 16,8.8 A 1.3,1.3 0 1,0 16,6.2 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.2" />
    <!-- Centered play triangle outline -->
    <path
        android:pathData="M 10.6,9.6 L 15.0,12.0 L 10.6,14.4 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
